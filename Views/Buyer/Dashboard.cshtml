@using ZalakProject.ViewModels
@model PaginatedResult<BuyerProductViewModel>

@{
    ViewBag.Title = "Buyer Dashboard";
}

<h2 class="mb-4 text-center">All Products</h2>

<div class="row">
    @foreach (var product in Model.Items)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="data:image/png;base64,@product.ProductImage" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@product.ProductName" />
                <div class="card-body d-flex flex-column justify-content-between">
                    <h5 class="card-title">@product.ProductName</h5>
                    <p class="card-text text-success fw-bold">₹@product.Price</p>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Product pagination">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Dashboard", new { page = i })">@i</a>
                </li>
            }
        </ul>
    </nav>
}